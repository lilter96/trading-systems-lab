# OKX Exchange Credentials (get from https://www.okx.com/account/trade-api)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=true

# mTLS Certificates
GRPC_CA_CERT=../../deployment/certs/ca.crt
GRPC_GATEWAY_CERT=../../deployment/certs/gateway.crt
GRPC_GATEWAY_KEY=

# Engine gRPC target
GRPC_TARGET=localhost:50051

# Port for emergency halt gRPC server (make halt / watchdog connect here)
GRPC_EMERGENCY_PORT=50050
