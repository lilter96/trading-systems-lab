# OKX Demo Credentials (get from https://www.okx.com/account/trade-api)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=true

# Watchdog Configuration
WD_HEARTBEAT_PORT=5555
WD_ALLOWED_MISSED_SECONDS=5
WD_BALANCE_POLL_SECONDS=2
WD_EQUITY_FLOOR_FRACTION=0.80
WD_STARTING_CAPITAL=10000

# Emergency Halt gRPC Targets
WD_EMERGENCY_TARGETS=localhost:50050

# mTLS Certificates (paths relative to watchdog-go/)
GRPC_CA_CERT=../../deployment/certs/ca.crt
GRPC_WATCHDOG_CERT=../../deployment/certs/watchdog.crt
GRPC_WATCHDOG_KEY=

# Telegram Alerts (create bot via @BotFather, get chat_id via @userinfobot)
WD_TELEGRAM_BOT_TOKEN=
WD_TELEGRAM_CHAT_ID=
